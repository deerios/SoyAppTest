DISCORD_BOT_TOKEN=
# Required. Used to fetch video title/description/channel via the YouTube
# Data API v3 (console.cloud.google.com -> APIs & Services -> Credentials).
YOUTUBE_API_KEY=
# Optional. Leave empty to disable AI summarization: videos not flagged as
# creator-summarized will then fail with a clear error instead of queuing.
ANTHROPIC_API_KEY=
